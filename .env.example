# Copy this to .env and fill in values
# Used by docker-compose.prod.yml

DB_PASSWORD=YourSecurePassword123!
REDIS_PASSWORD=YourRedisPassword
JWT_ACCESS_SECRET=your-very-long-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=your-very-long-refresh-secret-at-least-32-characters
IVR_API_TOKEN=your-ivr-api-token-from-ivrsolutions
IVR_SUBDOMAIN=your-ivr-subdomain
API_URL=https://api.yourdomain.com/api/v1
SOCKET_URL=https://api.yourdomain.com
