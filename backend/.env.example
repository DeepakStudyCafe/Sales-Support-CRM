NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=sales_crm
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here-change-it
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-change-it
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# IVR Solutions
IVR_API_BASE_URL=https://api.ivrsolutions.in
IVR_API_TOKEN=your-ivr-token
IVR_SUBDOMAIN=your-subdomain

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourcrm.com

# App
TIMEZONE=Asia/Kolkata
BCRYPT_ROUNDS=12
